{
  "name": "microlearning",
  "version": "1.1.1",
  "private": true,
  "description": "REST API for a micro-learning platform: courses, seasons, chapters, tasks, classes and OTP-based student authentication.",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanElahi/MicroLearning.git"
  },
  "keywords": [
    "microlearning",
    "express",
    "prisma",
    "postgresql",
    "rest-api"
  ],
  "license": "ISC",
  "dependencies": {
    "@casl/ability": "^6.7.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "formidable": "^2.1.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}
