# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma separated list of allowed origins, or * for any.
CORS_ORIGIN=*
# Public URL of this API; used to build links to uploaded media.
PUBLIC_BASE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=microlearning
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/microlearning?schema=public

# --- Auth (use long random strings: `openssl rand -hex 32`) ---------------
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# --- SMS / OTP (Kavenegar) ------------------------------------------------
# Leave empty in development: OTP codes are then printed to the server log.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=MicroLearning
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# --- Uploads --------------------------------------------------------------
# MEDIA_DIR=/absolute/path/to/media   (defaults to src/media)
MAX_UPLOAD_SIZE_MB=20

# --- First admin (used by `npm run seed:admin`) ---------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
